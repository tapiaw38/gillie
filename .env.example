# Application Configuration
APP_MODE=release
APP_PORT=8000
APP_HOST=0.0.0.0
APP_JWT_SECRET=your_jwt_secret_here
APP_ENCRYPTION_ALGORITHM=HS256

# General Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SCOPE=
SINGLE_USER_ID=

# Persona avatar MCP bridge
PERSONA_MCP_URL=http://127.0.0.1:47831/mcp
PERSONA_MCP_TIMEOUT=2.0

# ─── AI Provider ──────────────────────────────────────────────────────────────
# AI_PROVIDER: preset name (deepseek, openai, anthropic, kimi, kimi-k2, ollama)
# Leave empty to use OPENAI_* vars directly.
AI_PROVIDER=
AI_AUTH_TOKEN=your_api_key_here
AI_AUTH_TYPE=api_key

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
OPENAI_ROLE=user
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000
OPENAI_TIMEOUT=45.0
OPENAI_MAX_RETRIES=3

# Anthropic (used when AI_PROVIDER=anthropic or base_url contains anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT=45.0
ANTHROPIC_MAX_RETRIES=3

# Vision model (for image analysis tools)
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# ─── Database (MongoDB) ───────────────────────────────────────────────────────
DATABASE_URI=mongodb://localhost:27017
DB_NAME=assistant-ia-db
DB_COLLECTION_MIGRATIONS=migrations
DB_COLLECTION_CONVERSATIONS=conversations
DB_COLLECTION_PROFILES=profiles
DB_COLLECTION_FAQS=faqs
DB_COLLECTION_WHATSAPP_DEVICES=whatsapp_devices
DB_COLLECTION_JOBS=jobs
DB_COLLECTION_CALENDAR_SESSIONS=calendar_sessions
DB_COLLECTION_DRIVE_SESSIONS=drive_sessions
DB_COLLECTION_GMAIL_SESSIONS=gmail_sessions

# ─── Storage ──────────────────────────────────────────────────────────────────
# backend: local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=~/.local/share/gillie/storage
STORAGE_LOCAL_BASE_URL=http://localhost:8000/api/storage

# AWS S3 (only needed when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=assistant-ia-bucket

# ─── Embeddings ───────────────────────────────────────────────────────────────
# EMBEDDING_PROVIDER: openai | huggingface
EMBEDDING_PROVIDER=openai
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_EMBEDDING_DIMENSION=384

# ─── Qdrant Vector Database ───────────────────────────────────────────────────
# In production (docker-compose), use the service name: qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_USE_GRPC=false
# Optional: API key for Qdrant Cloud (leave empty for self-hosted)
QDRANT_API_KEY=

# ─── LangChain ────────────────────────────────────────────────────────────────
LANGCHAIN_SERVICE_ENABLED=true
LANGCHAIN_MAX_CONCURRENT_REQUESTS=3
LANGCHAIN_MEMORY_MAX_MESSAGES=20
LANGCHAIN_CHUNK_SIZE=1000
LANGCHAIN_CHUNK_OVERLAP=200
LANGCHAIN_MAX_PAGES=50
LANGCHAIN_ENABLE_VECTORS=true
LANGCHAIN_VECTOR_STORE=qdrant
LANGCHAIN_SIMILARITY_K=5
LANGCHAIN_LOG_LEVEL=INFO

# LangSmith (optional — observability/tracing)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gillie-api
LANGSMITH_ENDPOINT=
LANGSMITH_TRACING_ENABLED=false

# ─── Integrations ─────────────────────────────────────────────────────────────
TTS_ENABLED=false
STT_ENABLED=false
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=gillie_whatsapp_verification_token

GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/calendar/oauth/callback

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/v1/drive/oauth/callback

GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/gmail/oauth/callback
