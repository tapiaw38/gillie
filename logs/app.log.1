html: welcome test ## Analizes the coverage profiles generated by \'make test\' using html mode.\n\t@go tool cover -html=coverage.out\n\ngen-mocks: welcome ## Generate all mocks\n\t@echo "Generating mocks..."\n\t@go generate ./...\n\nclean: welcome ## Remove unused files and golang cache\n\t@go clean -cache\n\t-find . -name "*.out" -exec rm -f  {} \\;\n\trm -rf bin/\n\ninit-docker: welcome ## Initializes a local Docker instance\n\t@docker-compose up\n\ninit-mockserver: welcome ## Initializes a local Wiremock instance\n\t@docker rm mockserver -f\n\t@docker run -v ./resources/wiremock:/home/wiremock -p 8081:8080 --name mockserver wiremock/wiremock:3.3.1 --verbose\n\nmigrate-create: ## Create a new migration\n\t@read -p "Enter migration name: " name; \\\n\tmigrate create -dir migrations -ext sql $$name\n\nmigrate-up: welcome ## Apply all available migrations\n\t@migrate -path migrations -database \'postgres://postgres:postgres@localhost:54321/auth-api-db?sslmode=disable\' up\n\nmigrate-down: welcome ## Revert the last migration\n\t@migrate -path migrations -database \'postgres://postgres:postgres@localhost:54321/auth-api-db?sslmode=disable\' down\n\nhelp: welcome\n\t@grep -E \'^[a-zA-Z_-]+:.*?## .*$$\' $(MAKEFILE_LIST) | grep ^help -v | sort | awk \'BEGIN {FS = ":.*?## "}; {printf "\\033[36m%-15s\\033[0m %s\\n", $$1, $$2}', 'new_string': '.DEFAULT_GOAL:=help  # Define el objetivo por defecto al ejecutar solo \'make\'\n.PHONY: help welcome install-deps install-migrate run run-dev clean  # Declara que estos son objetivos "phony" (no archivos)\n\nwelcome: ## Welcome message - Muestra un mensaje de bienvenida con el nombre del proyecto\n\t@echo "\\033[1;33mIT-AUTH - AUTH API Back-End\\033[0m\\n"\n\ninstall-deps: welcome ## Install dependencies for running the project - Instala herramientas de desarrollo: Delve (debugger) y Air (live reloader)\n\t@echo "Installing Delve (debugger)..."\n\t@go install github.com/go-delve/delve/cmd/dlv@latest  # Instala Delve para debugging de Go\n\t@echo "Delve installation completed"\n\t@echo "Installing Air (live reloader)..."\n\t@go install github.com/air-verse/air@latest  # Instala Air para recarga automática durante desarrollo\n\t@echo "Air installation completed"\n\napt-install-migrate: welcome ## Install the migrate CLI tool - Instala la herramienta de migraciones para sistemas basados en Debian/Ubuntu (apt)\n\t@echo "Installing migrate CLI..."\n\t@sudo apt install --no-install-recommends -y postgresql-client curl && \\\n    curl -L -o /tmp/migrate.tar.gz https://github.com/golang-migrate/migrate/releases/download/v4.15.0/migrate.linux-amd64.tar.gz && \\\n    sudo tar xzf /tmp/migrate.tar.gz -C /usr/local/bin && \\\n    sudo chmod +x /usr/local/bin/migrate  # Descarga y extrae la herramienta migrate\n\t@echo "migrate installation completed"\n\npacman-install-migrate: welcome ## Install the migrate CLI tool - Instala la herramienta de migraciones para sistemas basados en Arch Linux (pacman)\n\t@echo "Installing migrate CLI..."\n\t@sudo pacman -S --noconfirm postgresql curl && \\\n    curl -L -o /tmp/migrate.tar.gz https://github.com/golang-migrate/migrate/releases/download/v4.15.0/migrate.linux-amd64.tar.gz && \\\n    sudo tar xzf /tmp/migrate.tar.gz -C /usr/local/bin && \\\n    sudo chmod +x /usr/local/bin/migrate  # Descarga y extrae la herramienta migrate\n\t@echo "migrate installation completed"\n\nrun: welcome ## Run project locally - Ejecuta la aplicación en modo producción usando \'go run\'\n\t@go run ./cmd/api/  # Ejecuta el punto de entrada principal de la API\n\nrun-dev: welcome ## Run project on watch mode for development purposes - Ejecuta la aplicación en modo desarrollo con recarga automática\n\t@air  # Usa Air para recarga automática al detectar cambios en el código\n\ntest: welcome ## Run tests project - Ejecuta todos los tests del proyecto con cobertura\n\t@echo "Running tests"\n\t@go test ./... -cover -coverprofile=coverage.out  # Ejecuta tests y genera reporte de cobertura\n\ncover: welcome test ## Analizes the coverage profiles generated by \'make test\' using function mode. - Muestra el reporte de cobertura en modo función\n\t@go tool cover -func=coverage.out  # Muestra porcentaje de cobertura por función\n\ncover-html: welcome test ## Analizes the coverage profiles generated by \'make test\' using html mode. - Genera reporte de cobertura en HTML\n\t@go tool cover -html=coverage.out  # Genera archivo HTML visual de cobertura\n\ngen-mocks: welcome ## Generate all mocks - Genera mocks para testing usando go generate\n\t@echo "Generating mocks..."\n\t@go generate ./...  # Ejecuta directivas //go:generate en todo el proyecto\n\nclean: welcome ## Remove unused files and golang cache - Limpia archivos temporales y caché de Go\n\t@go clean -cache  # Limpia caché de compilación de Go\n\t-find . -name "*.out" -exec rm -f  {} \\;  # Elimina archivos .out (como coverage.out)\n\trm -rf bin/  # Elimina directorio bin si existe\n\ninit-docker: welcome ## Initializes a local Docker instance - Inicia los contenedores Docker definidos en docker-compose.yml\n\t@docker-compose up  # Levanta todos los servicios definidos en docker-compose\n\ninit-mockserver: welcome ## Initializes a local Wiremock instance - Inicia un servidor Wiremock para mocking de APIs externas\n\t@docker rm mockserver -f  # Elimina contenedor existente si hay\n\t@docker run -v ./resources/wiremock:/home/wiremock -p 8081:8080 --name mockserver wiremock/wiremock:3.3.1 --verbose  # Inicia Wiremock con mapeo de volumen\n\nmigrate-create: ## Create a new migration - Crea un nuevo archivo de migración de base de datos\n\t@read -p "Enter migration name: " name; \\\n\tmigrate create -dir migrations -ext sql $$name  # Solicita nombre y crea archivos .up.sql y .down.sql\n\nmigrate-up: welcome ## Apply all available migrations - Aplica todas las migraciones pendientes a la base de datos\n\t@migrate -path migrations -database \'postgres://postgres:postgres@localhost:54321/auth-api-db?sslmode=disable\' up  # Ejecuta migraciones hacia arriba\n\nmigrate-down: welcome ## Revert the last migration - Revierte la última migración aplicada\n\t@migrate -path migrations -database \'postgres://postgres:postgres@localhost:54321/auth-api-db?sslmode=disable\' down  # Ejecuta migración hacia abajo\n\nhelp: welcome ## Show this help message - Muestra este mensaje de ayuda con todos los comandos disponibles\n\t@grep -E \'^[a-zA-Z_-]+:.*?## .*$$\' $(MAKEFILE_LIST) | grep ^help -v | sort | awk \'BEGIN {FS = ":.*?## "}; {printf "\\033[36m%-15s\\033[0m %s\\n", $$1, $$2}\'  # Extrae y formatea comandos con sus descripciones'}
