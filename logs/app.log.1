)\n            await send_button.click()\n            print("Mensaje enviado a Patri!")\n            \n        except Exception as e:\n            print(f"No se pudo enviar el mensaje automáticamente: {e}")\n            print("Por favor envía el mensaje manualmente")\n        \n        # Mantener abierto\n        print("El navegador permanecerá abierto por 2 minutos...")\n        await asyncio.sleep(120)\n        \n        await browser.close()\n\nif __name__ == "__main__":\n    asyncio.run(open_whatsapp())'}
