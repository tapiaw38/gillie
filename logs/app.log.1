\n                            \n                            # Buscar el contacto\n                            contacts = await page.query_selector_all(\'div[data-testid="cell-frame-container"]\')\n                            for contact in contacts:\n                                text = await contact.text_content()\n                                if "Patri" in text:\n                                    print(f"Contacto encontrado: {text}")\n                                    await contact.click()\n                                    await page.wait_for_timeout(1000)\n                                    \n                                    # Escribir mensaje\n                                    message_box = await page.query_selector(\'div[data-testid="conversation-compose-box-input"]\')\n                                    if message_box:\n                                        await message_box.click()\n                                        await page.type(\'div[data-testid="conversation-compose-box-input"]\', "Hola Patri, ¿cómo estás?")\n                                        await page.wait_for_timeout(1000)\n                                        \n                                        # Enviar mensaje\n                                        send_button = await page.query_selector(\'button[data-testid="compose-btn-send"]\')\n                                        if send_button:\n                                            await send_button.click()\n                                            print("Mensaje enviado a Patri")\n                                        else:\n                                            print("No se encontró el botón de enviar")\n                                    else:\n                                        print("No se encontró la caja de mensajes")\n                                    break\n                        else:\n                            print("No se encontró la barra de búsqueda")\n                    else:\n                        print("WhatsApp Web no parece estar conectado")\n                        \n                except Exception as e:\n                    print(f"Error al interactuar: {e}")\n                \n                break\n        \n        if not whatsapp_found:\n            print("WhatsApp Web no está abierto en ninguna pestaña")\n            # Abrir WhatsApp Web\n            page = await browser.new_page()\n            await page.goto("https://web.whatsapp.com")\n            print("WhatsApp Web abierto. Necesitas escanear el código QR")\n        \n        # Mantener abierto para que puedas ver\n        print("Manteniendo el navegador abierto por 30 segundos...")\n        await asyncio.sleep(30)\n        \n        await browser.close()\n\nif __name__ == "__main__":\n    asyncio.run(check_whatsapp())'}
